# ─────────────────────────────────────────────────────────────────────────────
# StreamX RAG Service — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# ── Security ──────────────────────────────────────────────────────────────────

# Admin API key — protects POST /api/admin/* endpoints.
# If blank, admin endpoints are unprotected (OK for local dev, NOT for production).
# Generate: openssl rand -hex 32
ADMIN_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to wildcard (/.*/), which is
# fine for local dev. Restrict in production:
#   CORS_ORIGINS=https://shop.example.com,https://aem.example.com
CORS_ORIGINS=

# ── AEM Push Webhook ──────────────────────────────────────────────────────────
# Enable the push webhook so AEM can notify the RAG service on publish/delete.
# When false (default), POST /api/webhook/aem returns 404.
AEM_WEBHOOK_ENABLED=false

# HMAC-SHA256 secret for verifying webhook requests from AEM (recommended).
# When set, AEM must send X-AEM-Signature: sha256=<hex(HMAC-SHA256(secret, body))>
# When empty, falls back to X-Admin-Key validation.
# Generate: openssl rand -hex 32
AEM_WEBHOOK_HMAC_SECRET=

# ── Optional connectors ────────────────────────────────────────────────────────

# AEM as a Cloud Service service token (Bearer auth).
# When set, overrides AEM Basic Auth (rag.aem.username / password).
# Leave empty for on-premise AEM with Basic Auth.
AEM_SERVICE_TOKEN=

# PIM API key (leave empty if PIM does not require auth)
PIM_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────

# OpenTelemetry collector OTLP endpoint (Jaeger / Tempo / etc.)
# Defaults to the bundled Jaeger inside docker-compose.
# To use an external collector: set OTEL_ENDPOINT=https://your-collector:4317
OTEL_ENDPOINT=

# ── Database credentials ──────────────────────────────────────────────────────
# Default values (raguser / ragpass) are safe for local dev.
# In production use strong, unique credentials and pass them as secrets.
# Must match on both the postgres service and the rag-service.
DB_USERNAME=raguser
DB_PASSWORD=ragpass

# ── Content sources ───────────────────────────────────────────────────────────
# AEM URL — defaults to the bundled mock server (demo mode).
# To use real AEM: set AEM_URL=https://author.your-aem.com
# (also update rag.aem.cf-list-query / cf-title-field / cf-body-field in application.properties)
AEM_URL=

# PIM URL — defaults to the bundled mock server (demo mode).
# To use real PIM: set PIM_URL=https://pim.your-company.com
PIM_URL=

# ── Internal Docker overrides (do not change) ─────────────────────────────────
# DB_URL is always set by docker-compose to point to the postgres container.
# DB_URL=jdbc:postgresql://postgres:5432/ragdb
